apiVersion: v1
kind: Service
metadata:
  name: ringforge-gateway
  namespace: ${RINGFORGE_NAMESPACE}
  labels:
    app.kubernetes.io/component: gateway
spec:
  type: ${RINGFORGE_GATEWAY_SERVICE_TYPE}
  selector:
    app: ringforge-gateway
  ports:
    - name: http
      port: 80
      targetPort: 8081
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: ringforge-gateway
  namespace: ${RINGFORGE_NAMESPACE}
  labels:
    app.kubernetes.io/component: gateway
spec:
  replicas: 1
  selector:
    matchLabels:
      app: ringforge-gateway
  template:
    metadata:
      labels:
        app: ringforge-gateway
        app.kubernetes.io/component: gateway
    spec:
      containers:
        - name: gateway
          image: ${RINGFORGE_IMAGE}
          imagePullPolicy: IfNotPresent
          args:
            - com.ringforge.chord.app.ServiceGatewayServer
            - --port
            - "8081"
            - --bootstrap
            - http://ringforge-node-0:5100
            - --kafka-bootstrap-servers
            - ringforge-kafka:9092
          ports:
            - containerPort: 8081
          resources:
            requests:
              cpu: 100m
              memory: 192Mi
            limits:
              cpu: 500m
              memory: 512Mi
          readinessProbe:
            httpGet:
              path: /api/health
              port: 8081
            initialDelaySeconds: 12
            periodSeconds: 5
          livenessProbe:
            httpGet:
              path: /api/health
              port: 8081
            initialDelaySeconds: 30
            periodSeconds: 15
